# Copy to .env and fill in. Never commit .env.

# Required only for tailoring / kit generation (the LLM calls).
# Ingestion, the dashboard, and the offline tools (ATS, diff, demo) work without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown):
# AUTO_APPLY_DB=jobsearch.db          # SQLite store path
# AUTO_APPLY_INDEX=.chroma            # Chroma RAG index path
# AUTO_APPLY_ALLOW_URL=0              # set 1 to enable the SSRF-guarded URL-fetch route

# Self-hosted inference (optional): run tailoring/kits on your own metal instead of the
# Anthropic API — any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, TGI).
# AUTO_APPLY_LLM_BACKEND=anthropic    # anthropic | local
# AUTO_APPLY_LLM_BASE_URL=http://your-cluster.local:8000/v1
# AUTO_APPLY_LLM_MODEL=llama-3.3-70b-instruct
# AUTO_APPLY_LLM_API_KEY=             # optional bearer token for your local gateway
